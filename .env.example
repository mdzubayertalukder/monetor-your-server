# PulseOps Server Monitoring Environment Configuration

# Server Port
PORT=8088

# Alert Thresholds (in percentage)
ALERT_CPU_THRESHOLD=85.0
ALERT_RAM_THRESHOLD=90.0
ALERT_DISK_THRESHOLD=90.0

# Optional Webhook Alert URLs
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Host Log Paths to Monitor (comma-separated)
LOG_PATHS=/var/log/syslog,/var/log/nginx/error.log,/var/log/messages
